// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

model User {
  id            String    @id @default(uuid())
  fullName      String
  email         String    @unique
  passwordHash  String
  phone         String?
  role          Role      @default(CUSTOMER)
  status        String    @default("active")
  state         String?
  city          String?
  area          String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  providerProfile Profile?
  customerBookings Booking[] @relation("CustomerBookings")
  providerBookings Booking[] @relation("ProviderBookings")
  reviews         Review[] @relation("CustomerReviews")
  providerReviews  Review[] @relation("ProviderReviews")

  @@map("users")
}

model Profile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String?
  fullName           String?
  bio                String?
  serviceCategory    String?
  categories         String[]
  state              String?
  city               String?
  areas              String[]
  experienceYears    Int                 @default(0)
  rating             Float               @default(0)
  reviewCount        Int                 @default(0)
  completedJobs      Int                 @default(0)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  available          Boolean             @default(true)
  responseTime       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  services Service[]

  @@map("profiles")
}

model Service {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  category    String
  description String?
  priceFrom   Decimal? @db.Decimal(10, 2)
  priceTo     Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@map("services")
}

model Booking {
  id                 String        @id @default(uuid())
  customerId         String
  providerId         String
  serviceId          String
  title              String
  description        String?
  location           String
  scheduledAt        DateTime?
  status             BookingStatus @default(PENDING)
  totalAmount        Decimal?      @db.Decimal(10, 2)
  cancellationReason  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer User @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  provider User @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reviews  Review[]

  @@map("bookings")
}

model Review {
  id         String   @id @default(uuid())
  customerId String
  providerId String
  bookingId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  customer User @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  provider User @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
